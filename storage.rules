rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/generations/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // written only by generateContent (Admin SDK)
    }

    // Locally-picked milestone photos that never went through a Wiro/generateContent round
    // trip (see MilestoneStore.capture / MilestoneRemoteStore.uploadPhoto) — the only
    // client-written path in this bucket, so it's scoped tightly: images only, 10MB cap.
    match /users/{userId}/milestones/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    // Collage videos rendered on-device by MilestoneVideoRenderer, uploaded so they show up in
    // the "My Collages" gallery on any future launch — see MilestoneCollageStore.uploadVideo.
    // 150MB cap is generous for a ~15-40s H.264 clip at the renderer's own bitrate target.
    match /users/{userId}/collages/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 150 * 1024 * 1024
        && request.resource.contentType.matches("video/.*");
    }

    match /users/{userId}/animations/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // written only by animateResult (Admin SDK)
    }
  }
}
