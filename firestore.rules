rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin panel sign-in: a doc here (keyed by the admin's Firebase Auth uid) is what makes
    // someone an admin. Only ever created via the Admin SDK (adminBootstrap function) — no client
    // can read or write this collection, but `exists()` below still works for rule evaluation
    // regardless (Firestore rules can check other paths' existence without a read grant on them).
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null && request.auth.uid == userId;
      // Credits/premium status are only ever changed server-side (Cloud Functions use the
      // Admin SDK, which bypasses these rules entirely) — block a client from writing them directly.
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['subscriptionCredits', 'purchasedCredits', 'isPremium', 'subscriptionRenewalDate', 'activeProductId']);
      allow delete: if false;

      match /generations/{generationId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow write: if false; // written only by generateContent (Admin SDK)
      }

      match /animations/{animationId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow write: if false; // written only by animateResult (Admin SDK)
      }

      match /milestones/{milestoneId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /favorites/{styleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /collages/{collageId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /ai_models/{styleId} {
      allow read: if true;
      allow write: if false; // seeded/edited only via seedThemes / the admin panel's Cloud Functions
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false; // seeded/edited only via seedThemes / the admin panel's Cloud Functions
    }

    match /credit_transactions/{transactionId} {
      allow read: if isAdmin();
      allow write: if false; // ledger is server-only
    }

    match /app_settings/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
