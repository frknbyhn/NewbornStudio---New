    "Want a change? Describe an edit — e.g. \\u{201c}add a soft blue blanket\\u{201d}": {
      "extractionState": "manual",
      "comment": "Result screen edit prompt placeholder",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir değişiklik mi istiyorsunuz? Bir düzenleme tarif edin — örn. “yumuşak mavi bir battaniye ekle”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Änderung gewünscht? Beschreiben Sie eine Bearbeitung — z. B. „eine weiche blaue Decke hinzufügen“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie d'un changement ? Décrivez une modification — ex. « ajouter une douce couverture bleue »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres un cambio? Describe una edición — p. ej. «añade una suave manta azul»"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi un cambiamento? Descrivi una modifica — es. «aggiungi una morbida coperta blu»"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quer uma mudança? Descreva uma edição — ex. “adicionar um cobertor azul macio”"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wil je een wijziging? Beschrijf een bewerking — bijv. “voeg een zachte blauwe deken toe”"
          }
        }
      }
    },
