          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "napr. „pridať mäkké zlaté svetlo a vznášajúce sa trblietky“ — nechajte prázdne na uloženie len fotky"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "pl. „adj hozzá lágy aranyfényt és lebegő csillámokat” — hagyd üresen, ha csak a fotót szeretnéd menteni"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "de ex. „adaugă o lumină aurie moale și scântei plutitoare” — lasă gol pentru a salva doar fotografia"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "npr. „dodaj meko zlatno svjetlo i lebdeće iskrice” — ostavite prazno da samo spremite fotografiju"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "π.χ. «πρόσθεσε απαλό χρυσό φως και αιωρούμενες λάμψεις» — αφήστε το κενό για απλή αποθήκευση της φωτογραφίας"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex. «afegeix una llum daurada suau i espurnes flotants» — deixa-ho en blanc per desar només la foto"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "mis. “tambahkan cahaya keemasan lembut dan kilauan melayang” — biarkan kosong untuk hanya menyimpan foto"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "cth. “tambah cahaya keemasan lembut dan kilauan terapung” — biarkan kosong untuk sekadar menyimpan foto"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ví dụ: “thêm ánh sáng vàng nhẹ nhàng và ánh lấp lánh lơ lửng” — để trống để chỉ lưu ảnh"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：「柔らかい金色の光と浮かぶきらめきを追加」— 写真だけを保存する場合は空欄のままにしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: “부드러운 황금빛과 떠다니는 반짝임 추가” — 사진만 저장하려면 비워 두세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：“添加柔和的金色光线和飘浮的闪光”——留空则仅保存照片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：“新增柔和的金色光線和飄浮的閃光”——留空則僅儲存照片"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น “เพิ่มแสงสีทองนุ่มนวลและประกายแวววาวลอยตัว” — เว้นว่างไว้เพื่อบันทึกเฉพาะรูปภาพ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उदा. “नरम सुनहरी रोशनी और तैरती चमक जोड़ें” — केवल फोटो सहेजने के लिए खाली छोड़ दें"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثال: «أضف ضوءًا ذهبيًا ناعمًا وبريقًا عائمًا» — اتركه فارغًا لحفظ الصورة فقط"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למשל, “הוסיפו אור זהוב רך וניצוצות מרחפים” — השאירו ריק כדי רק לשמור את התמונה"
          }
        }
      }
    },
    "e.g. \\u{201c}Turn my baby into a tiny astronaut floating among the stars\\u{201d}": {
      "extractionState": "manual",
      "comment": "Custom style prompt field placeholder",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "örn. “Bebeğimi yıldızların arasında süzülen minik bir astronota dönüştür”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. „mein Baby in einen kleinen Astronauten zwischen den Sternen verwandeln“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ex. « transformer mon bébé en petit astronaute flottant parmi les étoiles »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej. «convierte a mi bebé en un pequeño astronauta flotando entre las estrellas»"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "es. «trasforma il mio bambino in un piccolo astronauta che fluttua tra le stelle»"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ex. “transformar meu bebê em um pequeno astronauta flutuando entre as estrelas”"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. “verander mijn baby in een kleine astronaut die tussen de sterren zweeft”"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "np. „zamień moje dziecko w małego astronautę unoszącego się wśród gwiazd”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "например, «преврати моего малыша в маленького космонавта, парящего среди звёзд»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "наприклад, «перетвори мою дитину на маленького космонавта, що пливе серед зірок»"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. “forvandl min baby til en lille astronaut, der svæver blandt stjernerne”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "t.ex. ”förvandla min bebis till en liten astronaut som svävar bland stjärnorna”"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. «gjør babyen min om til en liten astronaut som svever blant stjernene»"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "esim. ”muuta vauvani pieneksi astronautiksi, joka leijuu tähtien keskellä”"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "např. „proměň mé miminko v malého astronauta vznášejícího se mezi hvězdami“"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "napr. „premeň moje bábätko na malého astronauta vznášajúceho sa medzi hviezdami“"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "pl. „változtasd a babámat egy kis űrhajóssá, aki a csillagok között lebeg”"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "de ex. „transformă-mi bebelușul într-un mic astronaut plutind printre stele”"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "npr. „pretvori moju bebu u malog astronauta koji lebdi među zvijezdama”"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "π.χ. «μετέτρεψε το μωρό μου σε έναν μικρό αστροναύτη που αιωρείται ανάμεσα στα αστέρια»"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex. «converteix el meu nadó en un petit astronauta flotant entre les estrelles»"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "mis. “ubah bayi saya menjadi astronaut kecil yang melayang di antara bintang-bintang”"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "cth. “ubah bayi saya menjadi angkasawan kecil yang terapung di antara bintang-bintang”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ví dụ: “biến em bé của tôi thành một phi hành gia nhỏ lơ lửng giữa các vì sao”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：「赤ちゃんを星の間に浮かぶ小さな宇宙飛行士に変える」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: “우리 아기를 별들 사이에 떠 있는 작은 우주비행사로 바꿔줘”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：“把我的宝宝变成漂浮在星星间的小宇航员”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：“把我的寶寶變成漂浮在星星間的小宇航員”"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น “เปลี่ยนลูกน้อยของฉันให้เป็นนักบินอวกาศตัวน้อยที่ลอยอยู่ท่ามกลางดวงดาว”"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उदा. “मेरे बच्चे को तारों के बीच तैरते एक छोटे अंतरिक्ष यात्री में बदल दें”"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثال: «حوّل طفلي إلى رائد فضاء صغير يطفو بين النجوم»"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למשל, “הפכו את התינוק שלי לאסטרונאוט קטן שמרחף בין הכוכבים”"
          }
        }
      }
    },
