    "Track baby's firsts and keep every precious memory beautifully organized.": {
      "extractionState": "manual",
      "comment": "Onboarding page 3 subtitle",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebeğinizin ilklerini takip edin ve her değerli anıyı güzelce düzenli tutun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgen Sie die Premieren Ihres Babys und halten Sie jede kostbare Erinnerung schön geordnet fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez les premières fois de votre bébé et gardez chaque souvenir précieux joliment organisé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue las primeras veces de tu bebé y mantén cada recuerdo precioso bien organizado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni traccia delle prime volte del tuo bambino e mantieni ogni ricordo prezioso ben organizzato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe as primeiras vezes do seu bebê e mantenha cada lembrança preciosa bem organizada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg de eerste keren van je baby en houd elke kostbare herinnering mooi georganiseerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź pierwsze chwile swojego dziecka i pięknie uporządkuj każde cenne wspomnienie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте первые достижения малыша и красиво храните каждое ценное воспоминание."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежуйте перші досягнення вашої дитини та зберігайте кожен цінний спогад впорядковано."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg din babys førstegangsoplevelser, og hold hvert dyrebart minde smukt organiseret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ din bebis första gånger och håll varje dyrbart minne snyggt organiserat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg babyens første gang-opplevelser, og hold hvert dyrebare minne pent organisert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa vauvasi ensimmäisiä kertoja ja pidä jokainen arvokas muisto kauniisti järjestyksessä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte první okamžiky svého miminka a udržujte každou vzácnou vzpomínku pěkně uspořádanou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte prvé momenty svojho bábätka a udržujte každú vzácnu spomienku pekne usporiadanú."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövesd nyomon a babád első alkalmait, és tartsd szépen rendezve minden drága emléket."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește premierele bebelușului tău și păstrează fiecare amintire prețioasă frumos organizată."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratite prve trenutke svoje bebe i lijepo organizirajte svaku dragocjenu uspomenu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθήστε τις πρώτες φορές του μωρού σας και κρατήστε κάθε πολύτιμη ανάμνηση όμορφα οργανωμένη."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueix les primeres vegades del teu nadó i mantén cada record preciós ben organitzat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacak momen pertama bayi Anda dan simpan setiap kenangan berharga dengan rapi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejaki detik pertama bayi anda dan simpan setiap kenangan berharga dengan tersusun rapi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi những lần đầu tiên của bé và giữ mọi kỷ niệm quý giá được sắp xếp gọn gàng."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤ちゃんの初めての体験を記録し、大切な思い出を美しく整理しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아기의 처음을 추적하고 소중한 추억을 아름답게 정리하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追踪宝宝的每一个第一次，把每份珍贵回忆整理得井井有条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤寶寶的每一個第一次，把每份珍貴回憶整理得井井有條。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามช่วงเวลาแรก ๆ ของลูกน้อย และจัดระเบียบความทรงจำอันล้ำค่าทุกช่วงเวลาให้สวยงาม"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने बच्चे के पहली बार होने वाले पलों को ट्रैक करें और हर कीमती याद को खूबसूरती से व्यवस्थित रखें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع لحظات طفلك الأولى واحتفظ بكل ذكرى ثمينة منظمة بشكل جميل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקבו אחרי הפעמים הראשונות של התינוק שלכם ושמרו על כל זיכרון יקר מאורגן בצורה יפה."
          }
        }
      }
