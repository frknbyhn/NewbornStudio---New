          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi mikser sporet ditt inn i dette collaget. Du kan følge fremdriften fra skjermen Mine collager."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekoitamme kappaleesi tähän kollaasiin. Voit seurata edistymistä Kollaasini-näytöltä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixujeme vaši skladbu do této koláže. Průběh můžete sledovat na obrazovce Moje koláže."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixujeme vašu skladbu do tejto koláže. Priebeh môžete sledovať na obrazovke Moje koláže."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A számodat belekeverjük ebbe a kollázsba. A folyamatot a Kollázsaim képernyőn követheted nyomon."
          }
        },
        "ro": {
