    "Close this and it's gone for good.": {
      "extractionState": "manual",
      "comment": "Limited offer last-chance footer note",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu kapatırsanız bir daha gelmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie dies schließen, ist es für immer weg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez ceci et il aura disparu pour toujours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra esto y desaparecerá para siempre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi questo e sparirà per sempre."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche isto e desaparecerá para sempre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit dit en het is voorgoed weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij to, a zniknie na zawsze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закройте это, и оно исчезнет навсегда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрийте це, і воно зникне назавжди."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Luk dette, og det er væk for altid."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stäng detta och det är borta för alltid."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukk dette, og det er borte for godt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulje tämä, ja se on poissa ikuisesti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavřete toto a zmizí to navždy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavrite toto a zmizne to navždy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zárd be, és örökre eltűnik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Închide asta și va dispărea pentru totdeauna."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvorite ovo i nestat će zauvijek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κλείστε αυτό και θα χαθεί για πάντα."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanca això i desapareixerà per sempre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup ini dan akan hilang selamanya."
          }
        },
