    "The \\u{201c}%@\\u{201d} collage video will be permanently deleted. This can't be undone.": {
      "extractionState": "manual",
      "comment": "Delete collage alert message, %@ is a list name",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” kolaj videosu kalıcı olarak silinecek. Bu işlem geri alınamaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Collage-Video „%@“ wird dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo de collage « %@ » sera définitivement supprimée. Cette action est irréversible."
          }
        },
        "es": {
