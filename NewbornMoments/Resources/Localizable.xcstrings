          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miksamo vašu pjesmu u ovaj kolaž. Napredak možete pratiti na zaslonu Moji kolaži."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναμειγνύουμε το κομμάτι σας σε αυτό το κολάζ. Μπορείτε να παρακολουθήσετε την πρόοδο από την οθόνη Τα κολάζ μου."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estem barrejant la teva pista en aquest collage. Pots seguir-ne el progrés des de la pantalla Els meus collages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami sedang mencampurkan trek Anda ke dalam kolase ini. Anda dapat mengikuti perkembangannya dari layar Kolase Saya."
