        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir bereiten Ihre Collage vor. Sie können den Fortschritt im Bildschirm „Meine Collagen“ verfolgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
