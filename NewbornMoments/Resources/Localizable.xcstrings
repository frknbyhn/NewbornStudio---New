    "Describe the music — e.g. \\u{201c}soft, dreamy piano lullaby, gentle and warm\\u{201d}": {
      "extractionState": "manual",
      "comment": "Collage music prompt placeholder",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müziği tarif edin — örn. “yumuşak, hayalimsi piyano ninnisi, sıcak ve nazik”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie die Musik — z. B. „sanftes, verträumtes Klavier-Schlaflied, warm und zart“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez la musique — ex. « berceuse au piano douce et rêveuse, chaleureuse et tendre »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe la música — p. ej. «nana de piano suave y soñadora, cálida y tierna»"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi la musica — es. «ninna nanna al pianoforte dolce e sognante, calda e delicata»"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva a música — ex. “canção de ninar de piano suave e sonhadora, quente e terna”"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf de muziek — bijv. “zacht, dromerig pianoslaapliedje, warm en teder”"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz muzykę — np. „delikatna, senna kołysanka fortepianowa, ciepła i czuła”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите музыку — например, «мягкая, мечтательная фортепианная колыбельная, тёплая и нежная»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишіть музику — наприклад, «м'яка, мрійлива фортепіанна колискова, тепла і ніжна»"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv musikken — f.eks. “blød, drømmende klavervuggevise, varm og øm”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv musiken — t.ex. ”mjuk, drömsk pianovaggvisa, varm och öm”"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv musikken — f.eks. «myk, drømmende pianovuggevise, varm og øm»"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaile musiikki — esim. ”pehmeä, unenomainen pianotuutulaulu, lämmin ja hellä”"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Popište hudbu — např. „jemná, snová klavírní ukolébavka, hřejivá a něžná“"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opíšte hudbu — napr. „jemná, snová klavírna uspávanka, hrejivá a nežná“"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd le a zenét — pl. „lágy, álomszerű zongorás altatódal, meleg és gyengéd”"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrie muzica — de ex. „cântec de leagăn liniștit la pian, cald și tandru”"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opišite glazbu — npr. „nježna, sanjiva uspavanka na klaviru, topla i blaga”"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιγράψτε τη μουσική — π.χ. «απαλό, ονειρικό νανούρισμα πιάνου, ζεστό και τρυφερό»"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Descriu la música — p. ex. «cançó de bressol de piano suau i somiadora, càlida i tendra»"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskripsikan musiknya — mis. “lagu pengantar tidur piano yang lembut dan penuh mimpi, hangat dan lembut”"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terangkan muzik — cth. “lagu buaian piano yang lembut dan bagai mimpi, hangat dan mesra”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô tả nhạc — ví dụ: “bài hát ru piano nhẹ nhàng, mơ màng, ấm áp và dịu dàng”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽を説明してください — 例：「柔らかく夢のようなピアノの子守唄、温かく優しい」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악을 설명해 주세요 — 예: “부드럽고 몽환적인 피아노 자장가, 따뜻하고 포근한”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述音乐——例如“柔和、梦幻的钢琴摇篮曲，温暖而柔情”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "描述音樂——例如“柔和、夢幻的鋼琴搖籃曲，溫暖而柔情”"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อธิบายเพลง — เช่น “เพลงกล่อมเด็กจากเปียโนที่นุ่มนวล แสนฝัน อบอุ่นและอ่อนโยน”"
          }
        },
        "hi": {
