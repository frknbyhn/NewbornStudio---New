    "Astronaut, fairy, tiny chef and more — a brand-new studio every single time." : {
      "comment" : "Onboarding page 2 subtitle",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رائد فضاء، جنية، طاهٍ صغير، والمزيد — استوديو جديد بالكامل في كل مرة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronauta, fada, petit xef i molt més — un estudi totalment nou cada vegada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronaut, víla, malý šéfkuchař a další — pokaždé úplně nové studio."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronaut, fe, lille kok og meget mere — et helt nyt studie hver gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronaut, Fee, kleiner Koch und mehr — jedes Mal ein brandneues Studio."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αστροναύτης, νεράιδα, μικρός σεφ και άλλα — ένα εντελώς νέο στούντιο κάθε φορά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronauta, hada, pequeño chef y más — un estudio totalmente nuevo cada vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronautti, keiju, pieni kokki ja paljon muuta — aina täysin uusi studio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronaute, fée, petit chef et plus encore — un tout nouveau studio à chaque fois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אסטרונאוט, פיה, שף קטן ועוד — סטודיו חדש לגמרי בכל פעם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अंतरिक्ष यात्री, परी, छोटा शेफ और भी बहुत कुछ — हर बार एक बिल्कुल नया स्टूडियो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronaut, vila, mali kuhar i još mnogo toga — svaki put potpuno novi studio."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Űrhajós, tündér, kis szakács és még sok más — minden alkalommal vadonatúj stúdió."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronaut, peri, koki kecil, dan lainnya — studio baru sepenuhnya setiap saat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronauta, fata, piccolo chef e altro — uno studio sempre nuovo ogni volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宇宙飛行士、妖精、小さなシェフなど — 毎回まったく新しいスタジオ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "우주비행사, 요정, 작은 셰프 등 — 매번 완전히 새로운 스튜디오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angkasawan, peri, cef kecil dan banyak lagi — studio baharu setiap kali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronaut, fe, liten kokk og mer — et helt nytt studio hver gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronaut, fee, kleine chef-kok en meer — elke keer een gloednieuwe studio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronauta, wróżka, mały szef kuchni i więcej — za każdym razem zupełnie nowe studio."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronauta, fada, pequeno chef e muito mais — um estúdio totalmente novo a cada vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronaut, zână, mic bucătar și multe altele — un studio complet nou de fiecare dată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Космонавт, фея, маленький шеф-повар и многое другое — каждый раз новая студия."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronaut, víla, malý šéfkuchár a ďalšie — vždy úplne nové štúdio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronaut, fe, liten kock och mer — en helt ny studio varje gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นักบินอวกาศ นางฟ้า เชฟตัวน้อย และอื่นๆ อีกมากมาย — สตูดิโอใหม่ทั้งหมดในทุกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronot, peri, minik şef ve daha fazlası — her seferinde yepyeni bir stüdyo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Космонавт, фея, маленький шеф-кухар та інше — щоразу нова студія."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi hành gia, tiên nữ, đầu bếp nhỏ và nhiều hơn nữa — một studio hoàn toàn mới mỗi lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宇航员、仙女、小厨师等等——每次都是全新的工作室。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宇航員、仙女、小廚師等等——每次都是全新的工作室。"
          }
        }
      }
    },
