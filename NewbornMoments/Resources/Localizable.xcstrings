          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте с любой темой или собственным запросом"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте з будь-якою темою або власним запитом"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug det til ethvert tema eller din egen brugerdefinerede prompt"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd med valfritt tema eller din egen anpassade prompt"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk med et hvilket som helst tema eller din egen egendefinerte prompt"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä minkä tahansa teeman kanssa tai omalla mukautetulla kehotteellasi"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte s libovolným tématem nebo vlastním zadáním"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite s ľubovoľnou témou alebo vlastným zadaním"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használd bármelyik témával vagy saját egyedi promptoddal"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește-l cu orice temă sau cu propriul tău prompt personalizat"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite s bilo kojom temom ili vlastitim prilagođenim upitom"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε το με οποιοδήποτε θέμα ή τη δική σας προτροπή"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitza-ho amb qualsevol tema o el teu propi text personalitzat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan dengan tema apa pun atau perintah khusus Anda sendiri"
