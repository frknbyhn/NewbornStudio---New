    "\\u{201c}%@\\u{201d} and its photo will be removed. This can't be undone.": {
      "extractionState": "manual",
      "comment": "Delete confirmation message, %@ is a milestone title",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ve fotoğrafı kaldırılacak. Bu işlem geri alınamaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ und das zugehörige Foto werden entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » et sa photo seront supprimés. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» y su foto se eliminarán. Esta acción no se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» e la sua foto verranno rimossi. Questa azione non può essere annullata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” e sua foto serão removidos. Esta ação não pode ser desfeita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” en de bijbehorende foto worden verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” i jego zdjęcie zostaną usunięte. Tej czynności nie można cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» и его фото будут удалены. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» та його фото буде видалено. Цю дію не можна скасувати."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” og dets foto fjernes. Dette kan ikke fortrydes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” och dess foto tas bort. Detta kan inte ångras."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» og bildet dets fjernes. Dette kan ikke angres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ja sen kuva poistetaan. Tätä ei voi kumota."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ a jeho fotka budou odstraněny. Tuto akci nelze vrátit zpět."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ a jeho fotka budú odstránené. Túto akciu nemožno vrátiť späť."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” és a hozzá tartozó fotó törlődik. Ez a művelet nem vonható vissza."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” și fotografia sa vor fi eliminate. Această acțiune nu poate fi anulată."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” i njezina fotografija bit će uklonjeni. Ova se radnja ne može poništiti."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» και η φωτογραφία του θα αφαιρεθούν. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» i la seva foto s'eliminaran. Aquesta acció no es pot desfer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” dan fotonya akan dihapus. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” dan fotonya akan dialih keluar. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” và ảnh của nó sẽ bị xóa. Hành động này không thể hoàn tác."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」とその写真は削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
