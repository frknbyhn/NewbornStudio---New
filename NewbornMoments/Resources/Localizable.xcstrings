    "We couldn't create the collage video. Please try again.": {
      "extractionState": "manual",
      "comment": "Collage error message",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolaj videosu oluşturulamadı. Lütfen tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Collage-Video konnte nicht erstellt werden. Bitte erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer la vidéo de collage. Veuillez réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear el video del collage. Inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare il video del collage. Riprova."
          }
        },
        "pt": {
