    "Describe the music — e.g. \\u{201c}soft, dreamy piano lullaby, gentle and warm\\u{201d}": {
      "extractionState": "manual",
      "comment": "Collage music prompt placeholder",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müziği tarif edin — örn. “yumuşak, hayalimsi piyano ninnisi, sıcak ve nazik”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie die Musik — z. B. „sanftes, verträumtes Klavier-Schlaflied, warm und zart“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez la musique — ex. « berceuse au piano douce et rêveuse, chaleureuse et tendre »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe la música — p. ej. «nana de piano suave y soñadora, cálida y tierna»"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi la musica — es. «ninna nanna al pianoforte dolce e sognante, calda e delicata»"
          }
