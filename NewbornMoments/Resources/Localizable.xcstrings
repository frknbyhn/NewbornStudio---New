    "AI-powered studio portraits in dozens of dreamy themes — created from a single snapshot.": {
      "extractionState": "manual",
      "comment": "Onboarding page 1 subtitle",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir kareden onlarca hayalimsi temada yapay zeka destekli stüdyo portreleri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-gestützte Studioporträts in Dutzenden traumhaften Stilen — aus einem einzigen Foto erstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portraits de studio générés par IA dans des dizaines de thèmes féeriques — créés à partir d'une seule photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retratos de estudio con IA en docenas de temas de ensueño — creados a partir de una sola foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritratti da studio con IA in decine di temi da sogno — creati da un solo scatto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Retratos de estúdio com IA em dezenas de temas encantadores — criados a partir de uma única foto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door AI gegenereerde studioportretten in tientallen dromerige thema's — gemaakt van één foto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portrety studyjne generowane przez AI w dziesiątkach magicznych motywów — stworzone z jednego zdjęcia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Студийные портреты на основе ИИ в десятках сказочных тем — созданы из одного снимка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Студійні портрети на основі ШІ у десятках казкових тем — створені з одного знімка."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-genererede studieportrætter i snesevis af drømmeagtige temaer — skabt ud fra ét billede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-genererade studioporträtt i dussintals drömlika teman — skapade från en enda bild."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-genererte studioportretter i dusinvis av drømmeaktige temaer — skapt fra ett bilde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoälyllä luotuja studiomuotokuvia kymmenissä unenomaisissa teemoissa — yhdestä kuvasta."
          }
        }
      }
