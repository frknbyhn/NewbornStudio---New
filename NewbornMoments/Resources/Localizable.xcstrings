    "This exclusive bundle won't be offered again. Grab it now, or it's gone for good.": {
      "extractionState": "manual",
      "comment": "Limited offer last-chance subtitle",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu özel paket bir daha sunulmayacak. Şimdi alın, yoksa bir daha gelmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses exklusive Paket wird nicht erneut angeboten. Sichern Sie es sich jetzt, sonst ist es für immer weg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce pack exclusif ne sera plus proposé. Profitez-en maintenant, sinon il aura disparu pour toujours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este paquete exclusivo no se volverá a ofrecer. Consíguelo ahora o desaparecerá para siempre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo pacchetto esclusivo non sarà più offerto. Prendilo ora, o sparirà per sempre."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pacote exclusivo não será oferecido novamente. Aproveite agora, ou desaparecerá para sempre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit exclusieve pakket wordt niet opnieuw aangeboden. Bemachtig het nu, of het is voorgoed weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten ekskluzywny pakiet nie będzie już oferowany. Zdobądź go teraz, albo zniknie na zawsze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот эксклюзивный пакет больше не будет предложен. Получите его сейчас, иначе он исчезнет навсегда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей ексклюзивний пакет більше не пропонуватиметься. Отримайте його зараз, інакше він зникне назавжди."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne eksklusive pakke tilbydes ikke igen. Grib den nu, ellers er den væk for altid."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta exklusiva paket erbjuds inte igen. Skaffa det nu, annars är det borta för alltid."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne eksklusive pakken tilbys ikke igjen. Sikre deg den nå, eller den er borte for godt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä ainutlaatuista pakettia ei tarjota enää uudelleen. Nappaa se nyt, tai se on poissa ikuisesti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento exkluzivní balíček již nebude nabízen. Získejte ho nyní, jinak zmizí navždy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento exkluzívny balík už nebude ponúkaný. Získajte ho teraz, inak zmizne navždy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt az exkluzív csomagot nem kínáljuk fel újra. Szerezd meg most, különben örökre eltűnik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest pachet exclusiv nu va mai fi oferit din nou. Obține-l acum, altfel va dispărea pentru totdeauna."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj ekskluzivni paket neće se ponovno nuditi. Preuzmite ga sada, ili će nestati zauvijek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αποκλειστικό πακέτο δεν θα προσφερθεί ξανά. Αποκτήστε το τώρα, αλλιώς θα χαθεί για πάντα."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest paquet exclusiu no es tornarà a oferir. Aconsegueix-lo ara, o desapareixerà per sempre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket eksklusif ini tidak akan ditawarkan lagi. Dapatkan sekarang, atau akan hilang selamanya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek eksklusif ini tidak akan ditawarkan lagi. Dapatkannya sekarang, atau ia akan hilang selama-lamanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói độc quyền này sẽ không được cung cấp lại. Nhận nó ngay bây giờ, nếu không nó sẽ biến mất mãi mãi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この限定パックは今後提供されません。今すぐ手に入れないと、永遠に失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 독점 팩은 다시 제공되지 않습니다. 지금 받지 않으면 영원히 사라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此专属礼包将不再提供。立即领取，否则将永远消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此專屬禮包將不再提供。立即領取，否則將永遠消失。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพ็กสุดพิเศษนี้จะไม่มีการเสนออีก รับตอนนี้ ไม่เช่นนั้นมันจะหายไปตลอดกาล"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह विशेष पैक फिर से नहीं दिया जाएगा। इसे अभी प्राप्त करें, वरना यह हमेशा के लिए चला जाएगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تُقدَّم هذه الباقة الحصرية مرة أخرى. احصل عليها الآن، وإلا فستختفي إلى الأبد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החבילה הבלעדית הזו לא תוצע שוב. השיגו אותה עכשיו, אחרת היא תיעלם לתמיד."
          }
        }
      }
    },
    "This photo has more than one face. Please choose a photo with just your baby in it.": {
      "extractionState": "manual",
      "comment": "Face detection error alert message",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğrafta birden fazla yüz var. Lütfen sadece bebeğinizin olduğu bir fotoğraf seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Foto ist mehr als ein Gesicht zu sehen. Bitte wählen Sie ein Foto mit nur Ihrem Baby."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo contient plus d'un visage. Veuillez choisir une photo avec seulement votre bébé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto tiene más de un rostro. Elige una foto con solo tu bebé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto contiene più di un volto. Scegli una foto con solo il tuo bambino."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto tem mais de um rosto. Escolha uma foto com apenas o seu bebê."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze foto bevat meer dan één gezicht. Kies een foto met alleen je baby erop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zdjęcie ma więcej niż jedną twarz. Wybierz zdjęcie tylko z Twoim dzieckiem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом фото больше одного лица. Выберите фото, где только ваш малыш."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому фото більше одного обличчя. Виберіть фото лише з вашою дитиною."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette foto har mere end ét ansigt. Vælg et foto med kun din baby."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta foto har mer än ett ansikte. Välj ett foto med bara din bebis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette bildet har mer enn ett ansikt. Velg et bilde med bare babyen din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä kuvassa on useampi kuin yksi kasvot. Valitse kuva, jossa on vain vauvasi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato fotka obsahuje více než jeden obličej. Vyberte fotku pouze s vaším miminkem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto fotka obsahuje viac ako jednu tvár. Vyberte fotku iba s vaším bábätkom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen a fotón egynél több arc látható. Válassz olyan fotót, amelyen csak a babád van."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această fotografie are mai mult de o față. Alege o fotografie doar cu bebelușul tău."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova fotografija ima više od jednog lica. Odaberite fotografiju samo s vašom bebom."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η φωτογραφία έχει περισσότερα από ένα πρόσωπα. Επιλέξτε μια φωτογραφία μόνο με το μωρό σας."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta foto té més d'un rostre. Tria una foto només amb el teu nadó."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto ini memiliki lebih dari satu wajah. Pilih foto yang hanya berisi bayi Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto ini mempunyai lebih daripada satu wajah. Pilih foto dengan hanya bayi anda sahaja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bức ảnh này có nhiều hơn một khuôn mặt. Vui lòng chọn một bức ảnh chỉ có em bé của bạn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真には複数の顔が写っています。お子様だけが写っている写真を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진에 얼굴이 두 개 이상 있습니다. 아기만 나온 사진을 선택해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片中有多张面孔。请选择只有您宝宝的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張照片中有多張面孔。請選擇只有您寶寶的照片。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพนี้มีมากกว่าหนึ่งใบหน้า กรุณาเลือกรูปภาพที่มีเฉพาะลูกน้อยของคุณ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फोटो में एक से अधिक चेहरे हैं। कृपया केवल अपने बच्चे वाली फोटो चुनें।"
          }
        },
        "ar": {
          "stringUnit": {
