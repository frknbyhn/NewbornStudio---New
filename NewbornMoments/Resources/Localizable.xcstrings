    "No collages yet — capture at least 5 milestones in a list, then tap \\u{201c}Create Collage\\u{201d} to create one.": {
      "extractionState": "manual",
      "comment": "Empty collages state message",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kolaj yok — bir listede en az 5 kilometre taşı yakalayın, ardından “Kolaj Oluştur”a dokunun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Collagen — erfassen Sie mindestens 5 Meilensteine in einer Liste und tippen Sie dann auf „Collage erstellen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de collages — capturez au moins 5 étapes dans une liste, puis appuyez sur « Créer un collage »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay collages — captura al menos 5 hitos en una lista y luego toca «Crear collage»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun collage — cattura almeno 5 traguardi in un elenco, poi tocca «Crea collage»."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem colagens — capture pelo menos 5 marcos em uma lista e toque em “Criar colagem”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen collages — leg minstens 5 mijlpalen vast in een lijst en tik dan op “Collage maken”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kolaży — uchwyć co najmniej 5 kamieni milowych na liście, a następnie dotknij „Utwórz kolaż”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет коллажей — зафиксируйте не менее 5 вех в списке, затем нажмите «Создать коллаж»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки немає колажів — зафіксуйте щонайменше 5 віх у списку, потім натисніть «Створити колаж»."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Endnu ingen collager — fang mindst 5 milepæle på en liste, og tryk så på “Opret collage”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga collage ännu — fånga minst 5 milstolpar i en lista och tryck sedan på ”Skapa collage”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen collager ennå — fang minst 5 milepæler i en liste, og trykk så på «Lag collage»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä kollaaseja — tallenna vähintään 5 virstanpylvästä listalle ja napauta sitten ”Luo kollaasi”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné koláže — zachyťte alespoň 5 milníků v seznamu a poté klepněte na „Vytvořit koláž“."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ žiadne koláže — zachyťte aspoň 5 míľnikov v zozname a potom ťuknite na „Vytvoriť koláž“."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincsenek kollázsok — rögzíts legalább 5 mérföldkövet egy listában, majd koppints a „Kollázs létrehozása” gombra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă niciun colaj — surprinde cel puțin 5 etape într-o listă, apoi atinge „Creează colaj”."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema kolaža — zabilježite barem 5 prekretnica na popisu, zatim dodirnite „Stvori kolaž”."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμη κολάζ — αποτυπώστε τουλάχιστον 5 ορόσημα σε μια λίστα και μετά πατήστε «Δημιουργία κολάζ»."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha collages — captura almenys 5 fites en una llista i després toca «Crea un collage»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada kolase — rekam setidaknya 5 tonggak dalam daftar, lalu ketuk “Buat Kolase”."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada kolaj — rakam sekurang-kurangnya 5 pencapaian dalam senarai, kemudian ketik “Cipta Kolaj”."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có ảnh ghép nào — ghi lại ít nhất 5 cột mốc trong một danh sách, sau đó nhấn “Tạo ảnh ghép”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだコラージュがありません — リストで少なくとも5つのマイルストーンを記録してから「コラージュを作成」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 콜라주가 없습니다 — 목록에서 최소 5개의 이정표를 기록한 후 “콜라주 만들기”를 탭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无拼贴 — 在列表中记录至少 5 个里程碑，然后点按“创建拼贴”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫無拼貼 — 在列表中記錄至少 5 個里程碑，然後點按“建立拼貼”。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีคอลลาจ — บันทึกพัฒนาการอย่างน้อย 5 รายการในรายการหนึ่ง จากนั้นแตะ “สร้างคอลลาจ”"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई कोलाज नहीं — एक सूची में कम से कम 5 माइलस्टोन कैद करें, फिर “कोलाज बनाएं” पर टैप करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد كولاجات بعد — التقط 5 معالم على الأقل في قائمة، ثم اضغط على «إنشاء كولاج»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין קולאז'ים — תעדו לפחות 5 אבני דרך ברשימה, ואז הקישו על “יצירת קולאז'”."
          }
        }
      }
    },
