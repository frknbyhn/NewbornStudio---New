            "value": "Einmaliges Angebot — endet, wenn der Timer abläuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offre unique — expire à la fin du minuteur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferta única — caduca cuando termine el temporizador."
          }
        },
