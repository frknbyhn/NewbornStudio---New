    "\\u{201c}%@\\u{201d} and its photo will be removed. This can't be undone.": {
      "extractionState": "manual",
      "comment": "Delete confirmation message, %@ is a milestone title",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ve fotoğrafı kaldırılacak. Bu işlem geri alınamaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ und das zugehörige Foto werden entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » et sa photo seront supprimés. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» y su foto se eliminarán. Esta acción no se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» e la sua foto verranno rimossi. Questa azione non può essere annullata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” e sua foto serão removidos. Esta ação não pode ser desfeita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” en de bijbehorende foto worden verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” i jego zdjęcie zostaną usunięte. Tej czynności nie można cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» и его фото будут удалены. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» та його фото буде видалено. Цю дію не можна скасувати."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” og dets foto fjernes. Dette kan ikke fortrydes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” och dess foto tas bort. Detta kan inte ångras."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» og bildet dets fjernes. Dette kan ikke angres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ja sen kuva poistetaan. Tätä ei voi kumota."
          }
        }
      }
    },
    "\\u{201c}%@\\u{201d} has already been captured. Deleting it removes the photo too — this can't be undone.": {
      "extractionState": "manual",
      "comment": "Delete milestone alert message, %@ is a milestone title",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” zaten yakalandı. Silmek fotoğrafı da kaldırır — bu işlem geri alınamaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wurde bereits erfasst. Beim Löschen wird auch das Foto entfernt — dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a déjà été capturé. Le supprimer retire aussi la photo — cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya ha sido capturado. Eliminarlo también quita la foto — esta acción no se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è già stato catturato. Eliminandolo verrà rimossa anche la foto — questa azione non può essere annullata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” já foi capturado. Excluí-lo também remove a foto — esta ação não pode ser desfeita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is al vastgelegd. Verwijderen verwijdert ook de foto — dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” zostało już uchwycone. Usunięcie usuwa też zdjęcie — tej czynności nie można cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» уже зафиксировано. Удаление также удалит фото — это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» вже зафіксовано. Видалення також прибере фото — цю дію не можна скасувати."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” er allerede fanget. Sletning fjerner også fotoet — dette kan ikke fortrydes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” har redan fångats. Att ta bort den tar även bort fotot — detta kan inte ångras."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er allerede fanget. Sletting fjerner også bildet — dette kan ikke angres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” on jo tallennettu. Sen poistaminen poistaa myös kuvan — tätä ei voi kumota."
          }
        }
      }
    },
