    "Some of your captured photos are still syncing. Please try again in a moment.": {
      "extractionState": "manual",
      "comment": "Collage sync error message",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalanan fotoğraflarınızdan bazıları hâlâ senkronize ediliyor. Lütfen biraz sonra tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Ihrer erfassten Fotos werden noch synchronisiert. Bitte versuchen Sie es gleich noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines de vos photos capturées sont encore en cours de synchronisation. Veuillez réessayer dans un instant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas de tus fotos capturadas todavía se están sincronizando. Inténtalo de nuevo en un momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune delle tue foto catturate sono ancora in fase di sincronizzazione. Riprova tra un momento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas das suas fotos capturadas ainda estão sincronizando. Tente novamente em instantes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige van je vastgelegde foto's worden nog gesynchroniseerd. Probeer het zo weer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre z Twoich zdjęć wciąż się synchronizują. Spróbuj ponownie za chwilę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые из ваших зафиксированных фото ещё синхронизируются. Повторите попытку через мгновение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі з ваших зафіксованих фото ще синхронізуються. Спробуйте ще раз за мить."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle af dine fangede fotos synkroniseres stadig. Prøv igen om et øjeblik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Några av dina fångade foton synkroniseras fortfarande. Försök igen om en stund."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen av bildene dine synkroniseres fortsatt. Prøv igjen om et øyeblikk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osa tallennetuista kuvistasi synkronoituu vielä. Yritä uudelleen hetken kuluttua."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé z vašich zachycených fotek se stále synchronizují. Zkuste to znovu za chvíli."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektoré z vašich zachytených fotiek sa stále synchronizujú. Skúste to znova o chvíľu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány rögzített fotód még szinkronizálás alatt áll. Próbáld újra egy pillanat múlva."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele dintre fotografiile tale surprinse încă se sincronizează. Încearcă din nou peste puțin timp."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neke od vaših zabilježenih fotografija još se sinkroniziraju. Pokušajte ponovno za trenutak."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένες από τις αποτυπωμένες φωτογραφίες σας εξακολουθούν να συγχρονίζονται. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunes de les teves fotos capturades encara s'estan sincronitzant. Torna-ho a provar d'aquí un moment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa foto Anda yang terekam masih dalam proses sinkronisasi. Coba lagi sesaat lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesetengah foto anda yang dirakam masih disegerakkan. Cuba lagi sebentar lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số ảnh đã ghi lại của bạn vẫn đang đồng bộ hóa. Vui lòng thử lại sau một lát."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録した写真の一部はまだ同期中です。少し待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 사진 중 일부가 아직 동기화 중입니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的一些已记录照片仍在同步中。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的一些已記錄照片仍在同步中。請稍後再試。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพที่บันทึกไว้บางส่วนของคุณยังคงซิงค์อยู่ กรุณาลองอีกครั้งในอีกสักครู่"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कुछ कैद की गई फोटो अभी भी सिंक हो रही हैं। कृपया थोड़ी देर बाद फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال بعض صورك الملتقطة قيد المزامنة. حاول مرة أخرى بعد قليل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מהתמונות שתיעדתם עדיין מסתנכרנות. נסו שוב בעוד רגע."
          }
