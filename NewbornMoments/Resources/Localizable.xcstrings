            "value": "Kolaj videosu oluşturulamadı. Lütfen tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Collage-Video konnte nicht erstellt werden. Bitte erneut versuchen."
