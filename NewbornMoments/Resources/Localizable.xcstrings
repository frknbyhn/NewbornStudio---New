    "Something went wrong and your credits were refunded. Please try again.": {
      "extractionState": "manual",
      "comment": "Generation error message",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şeyler ters gitti ve krediniz iade edildi. Lütfen tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen, und Ihre Credits wurden erstattet. Bitte erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu et vos crédits ont été remboursés. Veuillez réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal y tus créditos fueron reembolsados. Inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto e i tuoi crediti sono stati rimborsati. Riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado e seus créditos foram reembolsados. Tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is iets misgegaan en je credits zijn terugbetaald. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak, a Twoje kredyty zostały zwrócone. Spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так, и ваши кредиты возвращены. Повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось пішло не так, і ваші кредити повернено. Спробуйте ще раз."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget gik galt, og dine credits er blevet refunderet. Prøv igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något gick fel och dina krediter har återbetalats. Försök igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe gikk galt, og poengene dine er refundert. Prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokin meni pieleen, ja krediittisi on hyvitetty. Yritä uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Něco se pokazilo a vaše kredity byly vráceny. Zkuste to znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niečo sa pokazilo a vaše kredity boli vrátené. Skúste to znova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiba történt, és a krediteidet visszatérítettük. Próbáld újra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva nu a mers bine și creditele tale au fost rambursate. Încearcă din nou."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nešto je pošlo po zlu i vaši krediti su vraćeni. Pokušajte ponovno."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι πήγε στραβά και οι πιστώσεις σας επιστράφηκαν. Δοκιμάστε ξανά."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguna cosa ha anat malament i els teus crèdits han estat reemborsats. Torna-ho a provar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan dan kredit Anda telah dikembalikan. Silakan coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuatu tidak kena dan kredit anda telah dikembalikan. Sila cuba lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra sự cố và tín dụng của bạn đã được hoàn lại. Vui lòng thử lại."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生し、クレジットは返金されました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 발생하여 크레딧이 환불되었습니다. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题，您的积分已退还。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出了點問題，您的積分已退還。請重試。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาดและเครดิตของคุณได้รับการคืนแล้ว กรุณาลองอีกครั้ง"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ गलत हो गया और आपके क्रेडिट वापस कर दिए गए। कृपया फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما وتم استرداد رصيدك. حاول مرة أخرى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש והקרדיטים שלכם הוחזרו. נסו שוב."
          }
        }
      }
    },
