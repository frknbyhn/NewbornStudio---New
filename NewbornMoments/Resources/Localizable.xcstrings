    "e.g. \\u{201c}Add soft golden light and floating sparkles\\u{201d} — leave blank to just save the photo": {
      "extractionState": "manual",
      "comment": "Milestone capture prompt placeholder",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "örn. “Yumuşak altın ışık ve süzülen parıltılar ekle” — sadece fotoğrafı kaydetmek için boş bırakın"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. „weiches goldenes Licht und schwebende Funken hinzufügen“ — leer lassen, um nur das Foto zu speichern"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ex. « ajouter une douce lumière dorée et des étincelles flottantes » — laissez vide pour enregistrer simplement la photo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej. «añade una suave luz dorada y destellos flotantes» — deja en blanco para solo guardar la foto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "es. «aggiungi una luce dorata soffusa e scintille fluttuanti» — lascia vuoto per salvare solo la foto"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ex. “adicionar uma luz dourada suave e brilhos flutuantes” — deixe em branco para apenas salvar a foto"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. “voeg zacht goudlicht en zwevende sprankels toe” — laat leeg om alleen de foto op te slaan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "np. „dodaj miękkie złote światło i unoszące się iskierki” — pozostaw puste, aby po prostu zapisać zdjęcie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "например, «добавь мягкий золотой свет и парящие искры» — оставьте пустым, чтобы просто сохранить фото"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "наприклад, «додай м'яке золоте світло і летючі іскри» — залиште порожнім, щоб просто зберегти фото"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. “tilføj blødt gyldent lys og svævende glimmer” — lad stå tom for blot at gemme fotoet"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "t.ex. ”lägg till mjukt gyllene ljus och svävande glitter” — lämna tomt för att bara spara fotot"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. «legg til mykt gyllent lys og svevende glitter» — la stå tomt for bare å lagre bildet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "esim. ”lisää pehmeä kultainen valo ja leijuvia kimalteita” — jätä tyhjäksi tallentaaksesi vain kuvan"
          }
        }
      }
    },
